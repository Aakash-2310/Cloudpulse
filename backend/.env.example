# ---------------------------------------------------------------
# CloudPulse configuration. Copy to .env and adjust.
# Never commit .env – it is ignored by .gitignore.
# ---------------------------------------------------------------

# API
PORT=5000
NODE_ENV=development

# MongoDB / Redis (Docker Compose overrides these with service hostnames)
MONGO_URI=mongodb://localhost:27017/cloudpulse
REDIS_URL=redis://localhost:6379

# Auth – generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# true when served over HTTPS
COOKIE_SECURE=false

# Frontend origin(s) allowed by CORS (comma separated) and base URL used in reset links
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:5173

# Demo mode seeds realistic data automatically when the database is empty
DEMO_MODE=true

# Cloud provider adapters: mock (simulated data) | live (real AWS/Azure/GCP adapters)
CLOUD_PROVIDER_MODE=mock

# Monitoring loop (collects metrics, refreshes health checks, evaluates alert rules)
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=60000

# Redis cache TTLs (seconds)
CACHE_TTL_DASHBOARD=30
CACHE_TTL_RESOURCES=15
CACHE_TTL_SERVICE_HEALTH=10
CACHE_TTL_PROVIDERS=30
CACHE_TTL_ALERTS=15
CACHE_TTL_COSTS=60

LOG_LEVEL=info
